node_modules
**/node_modules
web/dist
data
# Local SQLite databases (dev pours, users, password hashes) must never be
# baked into an image. `data` above only matches the top-level folder.
server/data
**/*.sqlite
**/*.sqlite-*
**/*.db
.git
.github
*.md
!README.md
.env
.env.*
*service-account*.json

# The local dev database. `data` alone only matches the root; the one that
# actually exists is server/data, and gcpdeploy's tarball does not honour
# .gitignore, so this is the only thing keeping it out of the image.
**/data
**/*.sqlite
**/*.sqlite-*
