# ---------------------------------------------------------------------------
# Hopscotch configuration. Copy to .env for local development.
# .env is gitignored — never commit real secrets.
# ---------------------------------------------------------------------------

# Required in production. Generate one with: openssl rand -base64 48
# The server refuses to boot in production without it.
JWT_SECRET=

# 'sqlite' for local development, 'firestore' on Cloud Run.
# Cloud Run's container disk is ephemeral, so SQLite there loses data on every
# redeploy — Firestore is the only durable option for a deployed instance.
DB_DRIVER=sqlite
SQLITE_PATH=./data/hopscotch.sqlite

# Firestore (DB_DRIVER=firestore). On Cloud Run these come from the runtime
# service account via Application Default Credentials — no key file needed.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_PREFIX=hopscotch

# The sommelier. Leave blank and every AI feature switches itself off cleanly;
# the rest of the app is unaffected. This key is only ever read server-side.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_DAILY_MESSAGE_LIMIT=60

# Lock a personal deployment down to just you.
ALLOW_REGISTRATION=true
INVITE_EMAILS=

# Upstream directories. Nominatim's usage policy asks for an identifying
# User-Agent — put a real contact URL here for a public deployment.
BREWERY_API_BASE=https://api.openbrewerydb.org/v1
NOMINATIM_BASE=https://nominatim.openstreetmap.org
OUTBOUND_USER_AGENT=Hopscotch/1.0 (+https://github.com/eRock35/beer-app)

PORT=8080
